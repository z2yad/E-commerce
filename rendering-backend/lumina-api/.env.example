# ─── Server ───────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── MongoDB ──────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/lumina_ecommerce

# ─── JWT ──────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=lumina_access_secret_change_me_in_production_min_32_chars
JWT_REFRESH_SECRET=lumina_refresh_secret_change_me_in_production_min_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── Email (Nodemailer) ───────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM="Lumina Store <noreply@lumina.com>"

# ─── Frontend URL (CORS) ──────────────────────────────────────────
FRONTEND_URL=http://localhost:4200

# ─── File Upload ──────────────────────────────────────────────────
MAX_FILE_SIZE=5242880
UPLOAD_PATH=uploads

# ─── Rate Limiting ────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ─── Admin Seed ───────────────────────────────────────────────────
ADMIN_NAME=Admin Premium
ADMIN_EMAIL=admin@luxury.com
ADMIN_PASSWORD=admin123
